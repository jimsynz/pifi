# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

dev.db*
test*.db*

# `esbuild`, `tailwind` and `mix phx.digest` write everything under
# `priv/static/assets`, so the repository keeps none of it. The `firmware` alias
# runs `mix assets.deploy` before each build, and `mix setup` writes the same
# files for a person who clones this repository.
/priv/static/assets/
/priv/static/**/*.gz
/priv/static/cache_manifest.json
/priv/static/favicon-*.ico
/priv/static/robots-*.txt

# The cache of a host build and of a test. `MyHiFi.Cache` writes it beside the
# database, so a target holds it at `/root/cache` and a host holds it here.
/cache/
