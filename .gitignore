# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

dev.db*
test*.db*

# `esbuild`, `tailwind` and `mix phx.digest` write everything under
# `priv/static/assets`, so the repository keeps none of it. The `firmware` alias
# runs `mix assets.deploy` before each build, and `mix setup` writes the same
# files for a person who clones this repository.
/priv/static/assets/
/priv/static/**/*.gz
/priv/static/cache_manifest.json
/priv/static/favicon-*.ico
/priv/static/robots-*.txt

# The same, for the marks that a browser and a telephone ask for. Each name is written
# out rather than globbed, because `icon-maskable-512.png` is one this repository keeps
# and a pattern loose enough to catch a digest would catch that too.
/priv/static/icons/apple-touch-icon-*.png
/priv/static/icons/favicon-*.svg
/priv/static/icons/icon-192-*.png
/priv/static/icons/icon-512-*.png
/priv/static/icons/icon-maskable-512-*.png

# The cache of a host build and of a test. `PiFi.Cache` writes it beside the
# database, so a target holds it at `/root/cache` and a host holds it here.
/cache/

# `PiFi.Player.Download` writes an episode here while it reads it, and it moves
# the file into the cache at the end. A target holds this at `/root/partial`.
/partial/
