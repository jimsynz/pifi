# The two secrets that a firmware needs to reach NervesCloud. `config/target.exs`
# reads them, and a build that holds neither one connects to nothing. The org and
# the product name are for the `nh` command line, which uploads a firmware and
# starts a deployment.
#
# 1Password holds the values, so this file holds only the names of them.
export NERVES_HUB_ORG="$(op read 'op://Private/Nervescloud/mypihifiguy/org')"
export NERVES_HUB_PRODUCT="$(op read 'op://Private/Nervescloud/mypihifiguy/product')"
export NERVES_HUB_PRODUCT_KEY="$(op read 'op://Private/Nervescloud/mypihifiguy/product key')"
export NERVES_HUB_PRODUCT_SECRET="$(op read 'op://Private/Nervescloud/mypihifiguy/secret')"
