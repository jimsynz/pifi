<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={PiFi.Device.Identity.name()}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" href={~p"/icons/favicon.svg"} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={~p"/icons/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <meta name="theme-color" content="#2fc6e8" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-shell font-sans text-ink antialiased">
    {@inner_content}
  </body>
</html>
